# WindWatch Runtime Configuration

# Application Environment (production / development)
APP_ENV=production
DEBUG=false
PORT=8000

# Allowed CORS origins for browser clients (comma-separated)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Elexon BMRS Live Streaming API Endpoints
ELEXON_FUELHH_URL=https://data.elexon.co.uk/bmrs/api/v1/datasets/FUELHH/stream
ELEXON_WINDFOR_URL=https://data.elexon.co.uk/bmrs/api/v1/datasets/WINDFOR/stream
ELEXON_TIMEOUT_SECONDS=30
ELEXON_MAX_RETRIES=3

# Caching & Persistence
CACHE_TTL_SECONDS=900
DATA_DIR=backend/data
SNAPSHOT_FILENAME=elexon_snapshot.json
WARMUP_ON_STARTUP=true
